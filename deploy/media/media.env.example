# Copy to deploy/media/.env. The .env file is ignored by Git.
MEDIA_DATA_DIR=/absolute/user-owned/path/curmerce-media
MINIO_ROOT_USER=replace-with-random-user
MINIO_ROOT_PASSWORD=replace-with-at-least-32-random-characters
MINIO_BUCKET=curmerce-media
MINIO_API_PORT=59000
MINIO_CONSOLE_PORT=59001
CLAMAV_PORT=53310
IMGPROXY_PORT=58081
# Generate independent 64-character hex values, for example with: openssl rand -hex 32
IMGPROXY_KEY=replace-with-64-hex-characters
IMGPROXY_SALT=replace-with-64-hex-characters

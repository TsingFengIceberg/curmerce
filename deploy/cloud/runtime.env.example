# Copy to ~/.config/curmerce-services/runtime.env and keep mode 0600.
# This file contains only local runtime switches; credentials stay in credentials.env.
OTEL_TRACING_ENABLED=true
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
OTEL_TRACES_SAMPLER_PROBABILITY=1.0
CURMERCE_OUTBOX_TRANSPORT=redis
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:19092
CURMERCE_SEARCH_ENABLED=false
CURMERCE_ELASTICSEARCH_URL=http://127.0.0.1:19200
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-locally

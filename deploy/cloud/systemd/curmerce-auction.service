[Unit]
Description=Curmerce Auction boundary service
After=curmerce-nacos.service curmerce-yudao-server.service
Requires=curmerce-nacos.service
Wants=curmerce-yudao-server.service

[Service]
Type=simple
WorkingDirectory=/home/wugang/Data/Projects/curmerce
EnvironmentFile=-/home/wugang/.config/curmerce-services/runtime.env
Environment=NACOS_SERVER_ADDR=127.0.0.1:8848
Environment=CURMERCE_CORE_BASE_URL=http://127.0.0.1:48080
ExecStart=/home/wugang/.local/share/curmerce-toolchains/jdk-21/bin/java -Xms128m -Xmx384m -jar /home/wugang/Data/Projects/curmerce/curmerce-services/curmerce-auction-service/target/curmerce-auction-service.jar
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=30
LimitNOFILE=65535
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
